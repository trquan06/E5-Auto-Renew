# Host port published by Docker Compose.
HOST_BIND=127.0.0.1
HOST_PORT=8080

# Local Python stores renew.db and secret.key here. Docker Compose overrides
# this value with /app/data inside the container.
DATA_DIR=./data

# Exact external HTTPS origin when deployed behind a reverse proxy.
# Leave empty only for direct localhost use.
PUBLIC_BASE_URL=

# Optional comma-separated additional WebUI origins. Wildcards are not allowed.
ALLOWED_ORIGINS=

# Leave empty to generate and persist data/secret.key automatically.
SECRET_KEY=

DEFAULT_TIMEZONE=UTC
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Comma-separated IP addresses or CIDR ranges allowed to supply forwarded
# headers. Keep loopback for direct/local use; never set this to *.
FORWARDED_ALLOW_IPS=127.0.0.1

# Migration bridge only for an existing v1 deployment. New installations
# complete first-run setup instead. Remove after the password is persisted.
# WEBUI_PASSWORD=
